# ─── Servidor ───────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Base de datos (PostgreSQL via Docker) ───────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ztyloop?schema=public"

# ─── JWT ─────────────────────────────────────────────
# Genera claves con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-segura-de-minimo-32-caracteres
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=cambia-esto-por-otra-clave-diferente-y-segura-de-minimo-32-caracteres
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cloudinary (upload de imágenes) ─────────────────
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
